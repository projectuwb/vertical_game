{
  "name": "inkfall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "INKFALL — an on-rails ink-painting shooter.",
  "scripts": {
    "dev": "npm run generate-icons && vite",
    "build": "npm run generate-icons && tsc -p tsconfig.json --noEmit && vite build && npm run generate-sw && npm run verify-offline",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "build:cli": "tsc -p tsconfig.cli.json",
    "sim": "npm run build:cli && node dist-cli/balance/harness.js",
    "perf": "npm run build:cli && node dist-cli/balance/perf.js",
    "generate-icons": "npm run build:cli && node dist-cli/build/generateIcons.js",
    "generate-sw": "npm run build:cli && node dist-cli/build/generateServiceWorker.js",
    "verify-offline": "npm run build:cli && node dist-cli/build/verifyNoExternalFetch.js"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
